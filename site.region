<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {squarespace-headers}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/trg.css">
    <link rel="stylesheet" href="/assets/cms-editable.css">
    <link rel="stylesheet" href="/assets/trg-figma-v13.css">
  </head>
  <body id="{squarespace.page-id}" class="{squarespace.page-classes} trg-site">
    {.section website}
      {@|apply site-header.block}
    {.end}

    <main id="page" class="trg-main" role="main" data-content-field="main-content">
      {squarespace.main-content}
    </main>

    {.section website}
      {@|apply site-footer.block}
    {.end}

    <script src="/scripts/site.js"></script>
    {squarespace-scripts}
  </body>
</html>

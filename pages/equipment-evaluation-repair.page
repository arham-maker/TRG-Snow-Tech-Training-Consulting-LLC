<section class="section section--pad" aria-labelledby="repair-requirements-heading">
  <div class="split-service split-service--flip">
    <div class="split-service__media trg-editable trg-editable--media" data-trg-editable>
      <div class="trg-editable__fallback">
        <img src="/assets/images/airport.jpg" alt="Repair requirements">
      </div>
      <div class="trg-editable__cms">
        <squarespace:block-field id="equipmentEvaluationRepairRepairImage" columns="12" label="EDIT: Repair Requirements image" />
      </div>
    </div>
    <div class="split-service__content panel panel--soft">
      <div class="trg-editable" data-trg-editable>
        <div class="trg-editable__fallback">
          <h2 id="repair-requirements-heading" class="heading-lg">Repair Requirements</h2>
          <div class="rule" aria-hidden="true"></div>
          <p class="body-md">Describe the fault, symptom or damage requiring attention, along with any previous work. Repair requirements should be discussed for the specific equipment before scope and arrangements are agreed.</p>
          <h3 class="heading-sm">Useful Context</h3>
          <ul class="check-list">
            <li>Symptoms and operating impact</li>
            <li>Previous repairs or assessments</li>
            <li>Location and timing requirements</li>
          </ul>
        </div>
        <div class="trg-editable__cms">
          <squarespace:block-field id="equipmentEvaluationRepairRepair" columns="12" label="EDIT: Repair Requirements block" />
        </div>

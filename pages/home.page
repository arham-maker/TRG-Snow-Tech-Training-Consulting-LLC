    <article class="panel panel--image-card">
      <div class="trg-editable trg-editable--media" data-trg-editable>
        <div class="trg-editable__fallback">
          <img class="panel__bg" src="/assets/images/municipality.jpg" alt="Municipal snow removal">
        </div>
        <div class="trg-editable__cms">
          <squarespace:block-field id="homeMuniImage" columns="12" label="EDIT: Municipalities card image" />
        </div>
      </div>
      <div class="panel__gradient"></div>
      <div class="panel__body">
        <div class="trg-editable" data-trg-editable>
          <div class="trg-editable__fallback">
            <h3 class="heading-sm">Municipalities</h3>
            <p class="body-sm">Practical training and fleet planning support for municipal snow and ice removal vehicles.</p>
          </div>
          <div class="trg-editable__cms">
            <squarespace:block-field id="homeMuniCopy" columns="12" label="EDIT: Municipalities card copy" />
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section section--pad gallery-teaser" aria-labelledby="gallery-teaser-heading">
  <div class="panel panel--soft gallery-teaser__inner">

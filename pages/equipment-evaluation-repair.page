<section class="section section--pad" aria-labelledby="equipment-eval-share-heading">
  <div class="panel panel--soft">
    <div class="trg-editable" data-trg-editable>
      <div class="trg-editable__fallback">
        <h2 id="equipment-eval-share-heading" class="heading-lg">Share the Information That Matters</h2>
        <p class="body-md">A focused inquiry helps clarify what your equipment needs and how support may fit your operation.</p>
        <div class="rule" aria-hidden="true"></div>
        <div class="info-grid">
          <article class="info-card">
            <span class="num-badge">01</span>
            <h3 class="heading-sm">Identify the Asset</h3>
            <p class="body-sm">Provide the equipment type, make or model where available, and its role within your operation.</p>
          </article>
          <article class="info-card">
            <span class="num-badge">02</span>
            <h3 class="heading-sm">Describe the Concern</h3>
            <p class="body-sm">Explain what your team has observed, when the issue occurs and how it affects equipment use.</p>
          </article>
          <article class="info-card">
            <span class="num-badge">03</span>
            <h3 class="heading-sm">Add the Background</h3>
            <p class="body-sm">Include available maintenance history, previous repairs, assessments or other relevant records.</p>
          </article>
          <article class="info-card">
            <span class="num-badge">04</span>
            <h3 class="heading-sm">Clarify the Priority</h3>
            <p class="body-sm">Share your location, timing and whether the inquiry relates to repair needs, replacement planning or budgeting.</p>
          </article>
        </div>
      </div>
      <div class="trg-editable__cms">
        <squarespace:block-field id="equipmentEvaluationRepairShare" columns="12" label="EDIT: Share the Information That Matters" />
      </div>
    </div>
  </div>
</section>

